@page
@model CadastroModel
 

<h1>Cadastrar Produto:</h1>
<div>
    <form method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
        <div>
            <label for="nome">Cadastrar Produto:</label>
            <input name="produtoNome" id="nome" required />
        </div>
        <div>
            <label for="fabricante">Informe o Fabricante:</label>
            <input type="text" id="fabricante" name="fabricante" required />
        </div>
        <div>
            <label for="preco">Digite o Preço:</label>
            <input type="number" id="preco" name="preco" step="0.01" required />
        </div>
        <div>
            <label for="descricao">Descreva o produto:</label>
            <textarea id="descricao" name="descricao" required></textarea>
        </div>
        <div>
            <label for="estoque">Quantidade em Estoque:</label>
            <input type="number" id="estoque" name="estoque" required />
        </div>
            <div>
                <label for="img">Adicione o link da imagem:</label>
                @* <input type="file" id="img" name="img" required /> *@
            <input type="string" id="Img" name="Img" required />

            </div>

        <button type="submit">Cadastrar</button>
    </form>
</div>
